# NUNCA commite o arquivo .env (já está no .gitignore). Copie este arquivo: cp .env.example .env

# --- Groq (LLM): usado pelo chatbot da Sprint 03 e pela geração do RAG da Sprint 04 ---
GROQ_API_KEY=gsk_coloque_sua_chave_aqui
# Modelos comparados (docs/relatorio_modelos.md):
#   groq_oss        -> openai/gpt-oss-120b   (principal)
#   groq_secundario -> openai/gpt-oss-20b    (segundo modelo, bônus multi-provider)
LLM_PROVIDER=groq_oss
GROQ_MODEL_OSS=openai/gpt-oss-120b
GROQ_MODEL_SECUNDARIO=openai/gpt-oss-20b
SYSTEM_PROMPT_VERSION=v2

# --- Sprint 04: embeddings nomic-embed-text via Ollama ---
# OPÇÃO A (padrão, Ollama instalado na máquina): rode `ollama pull nomic-embed-text` e deixe como está.
OLLAMA_BASE_URL=http://localhost:11434
# OPÇÃO B (Ollama Cloud): descomente as duas linhas abaixo e use sua chave real (senão dá 401 unauthorized).
# OLLAMA_API_KEY=sua_chave_ollama_cloud
# OLLAMA_BASE_URL=https://ollama.com

# nomic   = exige o Ollama (use para a ENTREGA e para o modo live do eval)
# offline = embeddings por hashing, sem rede (testes/CI/sem internet)
# auto    = tenta nomic; se o Ollama estiver inacessível, cai para offline COM AVISO
EMBEDDINGS_BACKEND=auto

# --- Sprint 04: geração do RAG ---
# auto = groq_oss se houver GROQ_API_KEY, senão gerador extrativo offline (sem LLM)
LLM_PROVIDER_RAG=auto
# Iteração usada pela interface/CLI: baseline_s12 | iter1 | iter2 | iter3 (padrão)
RAG_ITERACAO=iter3
# Limiar de relevância (cosseno do melhor trecho). Em branco = padrão por backend
# (offline-hash: 0.22; nomic-embed-text: 0.55 -> recalibre com evals/calibrar_limiar.py)
# RAG_LIMIAR=0.55
